      "type": "securestring",
      "metadata": {
        "description": "Contraseña para el administrador SQL"
      }
    }
  },
  "variables": {
    "appServiceSku": "[if(equals(parameters('environment'), 'prod'), 'S1', 'B1')]",
    "sqlDatabaseTier": "[if(equals(parameters('environment'), 'prod'), 'Standard', 'Basic')]"
